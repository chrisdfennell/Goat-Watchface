# Build output
bin/

# NEVER COMMIT THIS. developer_key.der is the private key your Connect IQ apps
# are signed with; anyone who has it can publish to the store as you. Keep your
# copy locally, and for CI put a base64 of it in the GARMIN_DEVELOPER_KEY
# repository secret (see .github/workflows/release.yml).
developer_key.der
*.der
*.pem

# Local toolchain paths (JDK / SDK location differs per machine)
build_config.json

# Local agent/editor config
.claude/

